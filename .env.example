# GitHub personal access token with "repo" scope (classic) or
# "Contents: read and write" + "Metadata: read" (fine-grained) for the repos
# you want tracked. Write access to Contents is required for the
# "Send to Claude" feature, which commits notes into each repo's CLAUDE.md.
#
# In production this is set as a Netlify environment variable (Site
# settings > Environment variables), not in a committed file. This .env is
# only for local development with `netlify dev`, which loads it automatically.
GITHUB_TOKEN=

# Which repos to pull in during sync:
#   owner    - only repos you own (default)
#   all      - owner + collaborator + org member repos
GITHUB_AFFILIATION=owner

# Postgres connection string. Optional on Netlify — when it is unset the app
# falls back to the database Netlify attaches, which is the deployed path.
# Set it anywhere else: local development, a container, Vercel, a VPS. It is
# also what `npm run migrate` and `npm run test:e2e` operate on.
#
#   DATABASE_URL=postgres://postgres@127.0.0.1:5432/trackerator
DATABASE_URL=
