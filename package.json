{
  "name": "trackerator",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "A dashboard for tracking activity, status, goals and next steps across your own GitHub repos.",
  "scripts": {
    "dev": "netlify dev",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:e2e": "node --test test/e2e.test.ts",
    "migrate": "node scripts/migrate.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@netlify/database": "^2.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
